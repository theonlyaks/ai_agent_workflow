# Copy this file to `.env` and fill in your values.  `.env` is git-ignored.

# --- LLM (Claude) -----------------------------------------------------------
# Get a key at https://console.anthropic.com. Without a key the app still runs
# in OFFLINE mode: keyword-based routing + all non-LLM workflows work, LLM steps fail gracefully.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Server-side refusal fallback (Claude API feature); safe to leave on.
CLAUDE_REFUSAL_FALLBACK=true
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
# Set to false to force offline mode even when a key is present.
LLM_ENABLED=true

# --- Workflow sources --------------------------------------------------------
WORKFLOW_EXCEL_PATH=data/AI_Agent_Workflow_Assessment.xlsx
WORKFLOW_CONFIG_PATH=config/workflows.yaml

# --- Behaviour ---------------------------------------------------------------
SUMMARY_ENABLED=true
MAX_CLARIFICATION_ROUNDS=3
# Inject random transient failures into the mock order/shipment APIs (0.0 - 1.0)
# to demonstrate automatic retries.
MOCK_API_FAILURE_RATE=0.0

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
# true = JSON log lines on the console too (the file log is always JSON)
LOG_JSON_CONSOLE=false
